---
export const prerender = false;

import '@styles/global.css';
import ProductCard from '@components/ProductCard.astro';
import StoreHeader from '@components/StoreHeader.astro';
import StoreFooter from '@components/StoreFooter.astro';
import { getStoreConfigAsync } from '@lib/getShopConfig';

// Prevent serving stale product lists from browser or CDN cache
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

const url = new URL(Astro.request.url);
const tagOrCategoryFilter = url.searchParams.get('tag') || url.searchParams.get('category') || 'all';
const categoryFilter = tagOrCategoryFilter;
const searchQuery = (url.searchParams.get('search') || url.searchParams.get('q') || '').trim();

// Fetch direct single-store config
const shop = await getStoreConfigAsync();

if (!shop) {
  throw new Error('Failed to load store configuration from database.');
}

const { products: rawProducts = [], categories = [], theme } = shop;
const products = (rawProducts || []).filter((p: any) => p.is_active !== false);
const primaryColor = theme?.primary_color || '#581C87';

// Keyword & Semantic Relevance Scoring Algorithm
function computeRelevanceScore(product: any, queryStr: string): number {
  if (!queryStr) return 1;
  const q = queryStr.toLowerCase().trim();
  const rawTokens = q.split(/\s+/).filter(Boolean);
  
  const name = (product.name || '').toLowerCase();
  const desc = (product.description || '').toLowerCase();
  const category = (product.category_id || '').toLowerCase();
  const tags = Array.isArray(product.tags) ? product.tags.map((t: string) => t.toLowerCase()) : [];
  const tagsStr = tags.join(' ');

  let score = 0;

  if (name === q) score += 100;
  else if (name.startsWith(q)) score += 60;
  else if (name.includes(q)) score += 40;

  if (tags.includes(q)) score += 50;
  else if (tagsStr.includes(q)) score += 25;

  if (category === q) score += 30;

  const nameWords = name.split(/\s+/).filter(Boolean);
  let matchedTokens = 0;

  for (const token of rawTokens) {
    if (token.length < 2) continue;

    let tokenMatched = false;
    if (nameWords.some((w: string) => w === token || w.startsWith(token))) {
      score += 20;
      tokenMatched = true;
    } else if (name.includes(token)) {
      score += 10;
      tokenMatched = true;
    }

    if (tags.some((t: string) => t === token || t.startsWith(token))) {
      score += 15;
      tokenMatched = true;
    }

    if (category.includes(token)) {
      score += 10;
      tokenMatched = true;
    }

    if (desc.includes(token)) {
      score += 5;
      tokenMatched = true;
    }

    if (tokenMatched) matchedTokens++;
  }

  if (rawTokens.length > 1 && matchedTokens === rawTokens.length) {
    score += 35;
  }

  return score;
}

let scoredProducts = products.map((p: any) => {
  const score = searchQuery ? computeRelevanceScore(p, searchQuery) : 1;
  return { ...p, _score: score };
});

if (searchQuery) {
  scoredProducts = scoredProducts.filter((p: any) => p._score > 0);
  scoredProducts.sort((a: any, b: any) => b._score - a._score);
}

const initialProducts = scoredProducts.filter((p: any) => {
  if (categoryFilter === 'all') return true;
  if (p.category_id === categoryFilter) return true;
  if (Array.isArray(p.tags) && p.tags.includes(categoryFilter)) return true;
  return false;
});

// Server-side pagination calculation
const PAGE_SIZE = 16;
const requestedPage = parseInt(url.searchParams.get('page') || '1', 10);
const currentPage = isNaN(requestedPage) || requestedPage < 1 ? 1 : requestedPage;
const totalMatching = initialProducts.length;
const totalPages = Math.max(1, Math.ceil(totalMatching / PAGE_SIZE));
const safePage = Math.min(currentPage, totalPages);
const startIndex = (safePage - 1) * PAGE_SIZE;
const endIndex = Math.min(startIndex + PAGE_SIZE, totalMatching);
const paginatedProducts = initialProducts.slice(startIndex, endIndex);

// Build smart pagination range (window around current page)
const paginationRange: (number | string)[] = [];
if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i++) paginationRange.push(i);
} else {
  paginationRange.push(1);
  if (safePage > 3) paginationRange.push('...');
  const start = Math.max(2, safePage - 1);
  const end = Math.min(totalPages - 1, safePage + 1);
  for (let i = start; i <= end; i++) paginationRange.push(i);
  if (safePage < totalPages - 2) paginationRange.push('...');
  paginationRange.push(totalPages);
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>All Products & Catalog | {shop.name}</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <style define:vars={{ primaryColor }}>
    * { box-sizing: border-box; }
    .badge-dark {
      background-color: #1D2228;
      color: #FFFFFF;
    }
    .add-btn {
      background-color: var(--primaryColor);
      color: #FFFFFF;
    }
    .add-btn:hover {
      opacity: 0.9;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 antialiased min-h-screen flex flex-col">

  <div class="min-h-screen flex flex-col">
    <!-- Store Header Component -->
    <StoreHeader shop={shop} primaryColor={primaryColor} />

    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6 flex-1 w-full">
      <div class="text-center">
        <h1 id="catalog-header-title" class="font-serif-title text-2xl sm:text-3xl font-bold tracking-wider uppercase text-slate-900">
          {searchQuery ? `SEARCH RESULTS FOR "${searchQuery.toUpperCase()}"` : (categories.find((c: any) => c.id === categoryFilter)?.label || 'CATALOG & COLLECTION')}
        </h1>
        <p id="catalog-header-sub" class="text-xs text-slate-500 mt-1">
          {searchQuery ? `Showing ${initialProducts.length} matching products for "${searchQuery}"` : `Browse all curated products from ${shop.name}`}
        </p>
      </div>

      <!-- Catalog Toolbar -->
      <div class="border-y border-slate-200 bg-white px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600 select-none rounded-lg shadow-2xs">
        <!-- Left: Layout Grid View Toggles -->
        <div class="flex items-center space-x-2 border-r border-slate-200 pr-3 sm:pr-4">
          <button onclick="setCatalogColumns(2)" class="p-1 hover:bg-slate-100 rounded text-slate-600 hover:text-slate-900 cursor-pointer" title="2 Grid View">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M4 4h7v7H4V4zm9 0h7v7h-7V4zm-9 9h7v7H4v-7zm9 0h7v7h-7v-7z"/></svg>
          </button>
          <button onclick="setCatalogColumns(4)" class="p-1 hover:bg-slate-100 rounded text-slate-900 cursor-pointer" title="4 Grid View">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M3 3h4v4H3V3zm7 0h4v4h-4V3zm7 0h4v4h-4V3zM3 10h4v4H3v-4zm7 0h4v4h-4v-4zm7 0h4v4h-4v-4zM3 17h4v4H3v-4zm7 0h4v4h-4v-4zm7 0h4v4h-4v-4z"/></svg>
          </button>
        </div>

        <!-- Center: Product Count -->
        <div id="catalog-product-count" class="font-medium text-slate-500 text-xs tracking-wide">
          {initialProducts.length} products
        </div>

        <!-- Right: Category, Price, Sort By & Reset -->
        <div class="flex flex-wrap items-center border-l border-slate-200 pl-2 sm:pl-4 space-x-1 sm:space-x-3 font-medium">
          <!-- Category Filter -->
          <div class="flex items-center border-r border-slate-200 pr-1 sm:pr-3">
            <select id="catalog-category-select" onchange="applyFiltersAndSort()" class="bg-transparent text-slate-700 hover:text-slate-900 font-semibold text-xs py-1 px-1.5 focus:outline-none cursor-pointer border-0">
              <option value="all">Category: All</option>
              {categories.map((c: any) => (
                <option value={c.id} selected={categoryFilter === c.id}>{c.label}</option>
              ))}
            </select>
          </div>

          <!-- Price Range Filter -->
          <div class="flex items-center border-r border-slate-200 pr-1 sm:pr-3">
            <select id="catalog-price-select" onchange="applyFiltersAndSort()" class="bg-transparent text-slate-700 hover:text-slate-900 font-semibold text-xs py-1 px-1.5 focus:outline-none cursor-pointer border-0">
              <option value="all">Price: All</option>
              <option value="under_300">Under ₹ 300</option>
              <option value="300_700">₹ 300 - ₹ 700</option>
              <option value="700_1500">₹ 700 - ₹ 1500</option>
              <option value="above_1500">Above ₹ 1500</option>
            </select>
          </div>

          <!-- Sort By Dropdown -->
          <div class="flex items-center border-r border-slate-200 pr-1 sm:pr-3">
            <select id="catalog-sort-select" onchange="applyFiltersAndSort()" class="bg-transparent text-slate-700 hover:text-slate-900 font-semibold text-xs py-1 px-1.5 focus:outline-none cursor-pointer border-0">
              <option value="featured">Sort by: Featured</option>
              <option value="price_low_high">Price: Low to High</option>
              <option value="price_high_low">Price: High to Low</option>
              <option value="name_asc">Alphabetical: A to Z</option>
              <option value="name_desc">Alphabetical: Z to A</option>
            </select>
          </div>

          <!-- Reset Button -->
          <button onclick="resetFilters()" class="text-slate-500 hover:text-rose-600 font-semibold text-xs cursor-pointer transition-colors bg-transparent border-0 px-2 py-1">
            Reset
          </button>
        </div>
      </div>

      <div id="catalog-grid" class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        {paginatedProducts.map((product: any) => (
          <ProductCard product={product} />
        ))}
      </div>

      <!-- Pagination Controls Bar -->
      <div id="pagination-controls" class="mt-10 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div id="pagination-summary" class="text-xs font-semibold text-slate-500">
          Showing <span id="pag-start-count">{totalMatching > 0 ? startIndex + 1 : 0}</span> to <span id="pag-end-count">{endIndex}</span> of <span id="pag-total-count">{totalMatching}</span> products
        </div>

        <div id="pagination-buttons" class="flex flex-wrap items-center justify-center gap-1.5 select-none">
          <!-- Prev Button -->
          <a 
            href={currentPage > 1 ? `?category=${categoryFilter}&page=${currentPage - 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}` : '#'} 
            class={`px-3 py-2 text-xs font-bold rounded border no-underline ${currentPage > 1 ? 'border-slate-300 text-slate-700 hover:bg-slate-900 hover:text-white hover:border-slate-900 cursor-pointer' : 'border-slate-200 text-slate-300 pointer-events-none opacity-50'}`}
          >
            ⬅ Prev
          </a>

          <!-- Page Number Links -->
          {paginationRange.map((item) => (
            typeof item === 'number' ? (
              <a 
                href={`?category=${categoryFilter}&page=${item}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}`}
                class={`px-3 py-2 text-xs font-bold rounded border no-underline ${item === currentPage ? 'bg-slate-900 text-white border-slate-900' : 'border-slate-300 text-slate-700 hover:bg-slate-100'}`}
              >
                {item}
              </a>
            ) : (
              <span class="px-2 py-2 text-xs font-bold text-slate-400 select-none">...</span>
            )
          ))}

          <!-- Next Button -->
          <a 
            href={currentPage < totalPages ? `?category=${categoryFilter}&page=${currentPage + 1}${searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : ''}` : '#'} 
            class={`px-3 py-2 text-xs font-bold rounded border no-underline ${currentPage < totalPages ? 'border-slate-300 text-slate-700 hover:bg-slate-900 hover:text-white hover:border-slate-900 cursor-pointer' : 'border-slate-200 text-slate-300 pointer-events-none opacity-50'}`}
          >
            Next ➔
          </a>
        </div>
      </div>
    </main>

    <!-- Store Footer Component -->
    <StoreFooter shopName={shop.name} logoUrl={shop.logo_url} primaryColor={primaryColor} />

    <!-- Slide-Over Cart Drawer -->
    <div id="cart-overlay" onclick="toggleCartDrawer(false)" style="transition: opacity 0.3s ease; opacity: 0; pointer-events: none;" class="fixed inset-0 bg-slate-950/60 z-50"></div>
    <aside id="cart-drawer" style="transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); transform: translateX(100%);" class="fixed top-0 right-0 bottom-0 w-full sm:w-96 bg-white z-50 shadow-2xl flex flex-col justify-between">
      <div class="p-4 sm:p-6 border-b border-slate-200 flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <svg class="w-5 h-5 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span class="font-extrabold text-sm uppercase tracking-wider text-slate-900">Your Cart</span>
          <span id="cart-header-badge" class="bg-slate-900 text-white text-[11px] font-bold px-2 py-0.5 rounded-full">0 ITEMS</span>
        </div>
        <div class="flex items-center space-x-2">
          <button onclick="clearFullCart()" class="text-[11px] font-bold text-rose-600 hover:text-rose-800 hover:bg-rose-50 px-2 py-1 rounded transition-colors cursor-pointer" title="Empty Cart">Clear All</button>
          <button onclick="toggleCartDrawer(false)" class="w-8 h-8 rounded-full bg-white hover:bg-slate-200 text-slate-700 border border-slate-200 flex items-center justify-center transition-colors cursor-pointer" title="Close Cart">✕</button>
        </div>
      </div>

      <div class="flex-1 overflow-y-auto p-4 space-y-4">
        <div id="cart-items-list" class="space-y-3"></div>
        <div class="pt-4 border-t border-slate-200 space-y-3">
          <h4 class="text-xs font-extrabold uppercase tracking-wider text-slate-900">Customer Delivery Info</h4>
          <div class="space-y-2">
            <input id="checkout-name" type="text" placeholder="Enter Full Name (e.g. Divya Kodukula)" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:outline-none focus:border-slate-900" />
            <input id="checkout-phone" type="text" placeholder="Enter Phone Number (e.g. 8197921458)" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:outline-none focus:border-slate-900" />
            <input id="checkout-address" type="text" placeholder="Enter Delivery Address / Store Pickup" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:outline-none focus:border-slate-900" />
          </div>
        </div>
      </div>

      <div class="p-4 border-t border-slate-200 bg-slate-50 space-y-2.5">
        <div class="space-y-1 text-xs border-b border-slate-200 pb-2">
          <div class="flex justify-between items-center text-slate-500">
            <span>Total MRP:</span>
            <span id="cart-total-mrp" class="font-bold text-slate-700">₹ 0</span>
          </div>
          <div id="cart-savings-row" class="hidden flex justify-between items-center text-emerald-700 font-bold">
            <span>Total Savings:</span>
            <span id="cart-savings-val">- ₹ 0</span>
          </div>
        </div>

        <div class="flex justify-between items-center text-sm font-bold text-slate-900">
          <span>Total Payable (COD):</span>
          <span id="cart-total-price" class="text-rose-600 font-extrabold text-base">₹ 0</span>
        </div>

        <button onclick="placeRealWhatsAppOrder()" class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs uppercase tracking-widest rounded shadow-md transition-colors cursor-pointer">
          Place COD Order Now ➔
        </button>
      </div>
    </aside>

    <!-- Track Order Drawer -->
    <div id="track-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300" onclick="toggleTrackDrawer(false)"></div>
    <aside id="track-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[380px] bg-white z-50 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 space-y-6">
      <div class="flex justify-between items-center border-b border-slate-200 pb-4">
        <h2 class="font-extrabold text-slate-900 uppercase text-sm tracking-wider">Track Your Orders</h2>
        <button onclick="toggleTrackDrawer(false)" class="w-8 h-8 rounded-full hover:bg-slate-200 flex items-center justify-center font-bold text-slate-600 cursor-pointer">✕</button>
      </div>

      <div class="space-y-3">
        <label class="text-xs font-bold text-slate-700">Enter Your Registered Phone Number:</label>
        <div class="flex gap-2">
          <input type="tel" id="track-input" placeholder="e.g. 9876543210" class="flex-1 text-xs p-2.5 border border-slate-300 rounded focus:ring-1 focus:ring-slate-900 outline-none" />
          <button onclick="lookupOrderStatus()" class="px-4 py-2.5 bg-slate-900 text-white font-bold text-xs rounded hover:bg-slate-800 cursor-pointer">Search</button>
        </div>
      </div>

      <div id="track-results-box" class="flex-1 overflow-y-auto space-y-3">
        <div class="text-center py-8 text-slate-400 text-xs">Enter phone number to view live COD order status.</div>
      </div>
    </aside>

    <!-- Toast Notification Modal -->
    <div id="shop-toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 text-white p-4 rounded-xl shadow-2xl flex items-center space-x-3 max-w-sm border border-slate-700">
      <span id="toast-icon" class="text-2xl">✨</span>
      <div>
        <h4 id="toast-title" class="font-bold text-xs text-white">Notification</h4>
        <p id="toast-message" class="text-[11px] text-slate-300 mt-0.5">Operation complete.</p>
      </div>
    </div>

    <!-- Client Script for Catalog Interactions -->
    <script is:inline define:vars={{ initialCatalogProducts: initialProducts, currentShopName: shop.name }}>
      const allCatalogProducts = initialCatalogProducts;
      let activeFilteredProducts = [...allCatalogProducts];
      let currentClientPage = 1;
      const CLIENT_PAGE_SIZE = 16;
      let cart = {};

      window.setCatalogColumns = function(cols) {
        const grid = document.getElementById('catalog-grid');
        if (!grid) return;
        if (cols === 2) {
          grid.className = 'grid grid-cols-2 gap-4 sm:gap-6';
        } else {
          grid.className = 'grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6';
        }
      };

      window.applyFiltersAndSort = function() {
        const catVal = document.getElementById('catalog-category-select')?.value || 'all';
        const priceVal = document.getElementById('catalog-price-select')?.value || 'all';
        const sortVal = document.getElementById('catalog-sort-select')?.value || 'featured';

        let filtered = allCatalogProducts.filter(p => {
          if (catVal !== 'all' && p.category_id !== catVal && (!Array.isArray(p.tags) || !p.tags.includes(catVal))) {
            return false;
          }
          const price = Number(p.price || 0);
          if (priceVal === 'under_300' && price >= 300) return false;
          if (priceVal === '300_700' && (price < 300 || price > 700)) return false;
          if (priceVal === '700_1500' && (price < 700 || price > 1500)) return false;
          if (priceVal === 'above_1500' && price <= 1500) return false;
          return true;
        });

        if (sortVal === 'price_low_high') filtered.sort((a, b) => Number(a.price) - Number(b.price));
        else if (sortVal === 'price_high_low') filtered.sort((a, b) => Number(b.price) - Number(a.price));
        else if (sortVal === 'name_asc') filtered.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
        else if (sortVal === 'name_desc') filtered.sort((a, b) => (b.name || '').localeCompare(a.name || ''));

        activeFilteredProducts = filtered;
        currentClientPage = 1;
        renderCatalogPage();
      };

      window.resetFilters = function() {
        const catSelect = document.getElementById('catalog-category-select');
        const priceSelect = document.getElementById('catalog-price-select');
        const sortSelect = document.getElementById('catalog-sort-select');
        if (catSelect) catSelect.value = 'all';
        if (priceSelect) priceSelect.value = 'all';
        if (sortSelect) sortSelect.value = 'featured';
        activeFilteredProducts = [...allCatalogProducts];
        currentClientPage = 1;
        renderCatalogPage();
      };

      window.renderCatalogPage = function() {
        const grid = document.getElementById('catalog-grid');
        const countElem = document.getElementById('catalog-product-count');
        if (countElem) countElem.innerText = `${activeFilteredProducts.length} products`;

        const totalItems = activeFilteredProducts.length;
        const totalPages = Math.max(1, Math.ceil(totalItems / CLIENT_PAGE_SIZE));
        const safePage = Math.min(currentClientPage, totalPages);
        const startIdx = (safePage - 1) * CLIENT_PAGE_SIZE;
        const endIdx = Math.min(startIdx + CLIENT_PAGE_SIZE, totalItems);
        const pageItems = activeFilteredProducts.slice(startIdx, endIdx);

        if (grid) {
          if (pageItems.length === 0) {
            grid.innerHTML = `<div class="col-span-full py-12 text-center text-xs text-slate-500 bg-slate-50 border border-dashed border-slate-300 rounded-xl">No products match your selected filters. Click "Reset Filters" to clear.</div>`;
          } else {
            grid.innerHTML = pageItems.map(product => {
              const itemMrp = Number(product.mrp || product.price || 0);
              const itemDisc = product.discount !== undefined ? Number(product.discount) : (product.price && itemMrp > product.price ? Math.round(((itemMrp - product.price) / itemMrp) * 100) : 0);
              const itemPrice = Math.round(itemMrp * (1 - itemDisc / 100));

              return `
              <div class="catalog-item space-y-2 sm:space-y-3 group">
                <div class="relative aspect-square overflow-hidden bg-[#F5F3EE] cursor-pointer rounded-lg">
                  <a href="/product/${product.id}" class="block w-full h-full">
                    <img src="${product.image_url}" alt="${product.name}" loading="lazy" class="w-full h-full object-contain p-3 mix-blend-multiply group-hover:scale-105 transition-transform duration-500" />
                  </a>
                  ${product.badge ? `<span class="absolute top-2 left-2 bg-[#1D2228] text-white text-[9px] sm:text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 sm:py-1 rounded">${product.badge}</span>` : ''}
                </div>

                <div class="space-y-1">
                  <a href="/product/${product.id}" class="no-underline block">
                    <h3 class="text-xs font-semibold text-slate-900 leading-snug line-clamp-2 hover:text-rose-600 transition-colors">${product.name}</h3>
                  </a>
                  <div class="flex items-center justify-between pt-0.5">
                    <div class="text-[11px] sm:text-xs font-medium space-x-1">
                      <span class="font-bold text-slate-900">Price:</span>
                      <span class="font-bold text-rose-600">₹ ${itemPrice}</span>
                      ${itemDisc > 0 && itemMrp > itemPrice ? `<span class="line-through text-slate-400">₹ ${itemMrp}</span>` : ''}
                      ${itemDisc > 0 ? `<span class="font-bold text-emerald-700 bg-emerald-50 px-1 py-0.2 rounded text-[10px] ml-1">${itemDisc}% OFF</span>` : ''}
                    </div>
                    <button 
                      type="button"
                      class="add-btn text-xs font-semibold px-2 py-1 bg-slate-100 hover:bg-slate-900 hover:text-white rounded transition-colors cursor-pointer border border-slate-300"
                      title="Quick Add to Cart"
                      onclick="event.preventDefault(); event.stopPropagation(); addToCart('${product.id}', '${(product.name || '').replace(/'/g, "\\'")}', ${itemPrice}, ${itemMrp}, '${product.image_url}', 100, ${itemDisc})"
                    >
                      + Add
                    </button>
                  </div>
                </div>
              </div>
            `;
            }).join('');
          }
        }

        const summaryElem = document.getElementById('pagination-summary');
        if (summaryElem) {
          summaryElem.innerHTML = `Showing <span id="pag-start-count">${totalItems > 0 ? startIdx + 1 : 0}</span> to <span id="pag-end-count">${endIdx}</span> of <span id="pag-total-count">${totalItems}</span> products`;
        }
      };

      // Cart logic
      window.loadCart = function() {
        try {
          let saved = localStorage.getItem('yesfancy_cart');
          if (!saved) {
            saved = localStorage.getItem('oorumart_cart_yesfancy');
            if (saved) localStorage.setItem('yesfancy_cart', saved);
          }
          if (saved) cart = JSON.parse(saved);
        } catch (e) {
          cart = {};
        }
        window.renderCart();
      };

      window.saveCart = function() {
        try {
          localStorage.setItem('yesfancy_cart', JSON.stringify(cart));
        } catch (e) {}
        window.renderCart();
      };

      window.clearFullCart = function() {
        cart = {};
        window.saveCart();
      };

      window.addToCart = function(id, name, price, mrp, image_url, stock = 100, discount = 0) {
        const finalMrp = Number(mrp || price || 0);
        const finalDiscount = Number(discount || 0);
        const finalPrice = Math.round(finalMrp * (1 - finalDiscount / 100));

        if (cart[id]) {
          cart[id].qty += 1;
        } else {
          cart[id] = { id, name, price: finalPrice, mrp: finalMrp, discount: finalDiscount, image: image_url, image_url, qty: 1, stock };
        }
        window.saveCart();
        window.toggleCartDrawer(true);
      };

      window.updateCartQty = function(id, delta) {
        if (cart[id]) {
          cart[id].qty += delta;
          if (cart[id].qty <= 0) delete cart[id];
          window.saveCart();
        }
      };

      window.renderCart = function() {
        const itemsList = document.getElementById('cart-items-list');
        const badge = document.getElementById('cart-count-badge');
        const headerBadge = document.getElementById('cart-header-badge');
        const totalPriceElem = document.getElementById('cart-total-price');
        const totalMrpElem = document.getElementById('cart-total-mrp');
        const savingsVal = document.getElementById('cart-savings-val');
        const savingsRow = document.getElementById('cart-savings-row');

        let totalQty = 0;
        let totalPrice = 0;
        let totalMrp = 0;
        if (itemsList) itemsList.innerHTML = '';

        const keys = Object.keys(cart);
        if (keys.length === 0) {
          if (itemsList) {
            itemsList.innerHTML = `<div class="text-center py-8 text-slate-400 text-xs font-semibold">Your cart is empty. Add items to checkout!</div>`;
          }
        } else {
          keys.forEach(id => {
            const item = cart[id];
            const itemMrp = Number(item.mrp || item.price || 0);
            const itemDisc = Number(item.discount || 0);
            const itemPrice = Math.round(itemMrp * (1 - itemDisc / 100));
            const imgUrl = item.image_url || item.image || item.imageUrl || '/images/placeholder.webp';

            totalQty += item.qty;
            totalPrice += itemPrice * item.qty;
            totalMrp += itemMrp * item.qty;

            if (itemsList) {
              const div = document.createElement('div');
              div.className = 'border border-slate-200 rounded-lg p-3 flex space-x-3 items-center';
              div.innerHTML = `
                <img src="${imgUrl}" onerror="this.onerror=null;this.src='/images/placeholder.webp';" alt="${item.name || 'Product'}" class="w-14 h-14 object-contain rounded-md border border-slate-100 bg-slate-50 p-1" />
                <div class="flex-1 space-y-1">
                  <h4 class="text-xs font-bold text-slate-900 line-clamp-1">${item.name}</h4>
                  <div class="flex items-center gap-1.5 text-xs font-bold text-slate-900">
                    <span class="text-rose-600">₹ ${itemPrice}</span>
                    ${itemDisc > 0 ? `<span class="text-slate-400 font-normal line-through text-[11px]">₹ ${itemMrp}</span>
                    <span class="text-[9px] font-bold text-emerald-700 bg-emerald-50 px-1 py-0.2 rounded">${itemDisc}% OFF</span>` : ''}
                  </div>
                </div>
                <div class="flex items-center space-x-2 border border-slate-300 rounded px-2 py-1 text-xs">
                  <button onclick="updateCartQty('${id}', -1)" class="font-bold cursor-pointer px-1 hover:text-rose-600">-</button>
                  <span class="font-bold px-1">${item.qty}</span>
                  <button onclick="updateCartQty('${id}', 1)" class="font-bold cursor-pointer px-1 hover:text-emerald-600">+</button>
                </div>
              `;
              itemsList.appendChild(div);
            }
          });
        }

        const totalSavings = Math.max(0, totalMrp - totalPrice);

        if (badge) badge.innerText = totalQty;
        if (headerBadge) headerBadge.innerText = `${totalQty} ${totalQty === 1 ? 'ITEM' : 'ITEMS'}`;
        if (totalPriceElem) totalPriceElem.innerText = `₹ ${totalPrice}`;
        if (totalMrpElem) totalMrpElem.innerText = `₹ ${totalMrp}`;
        if (savingsVal) savingsVal.innerText = `- ₹ ${totalSavings}`;
        if (savingsRow) {
          if (totalSavings > 0) savingsRow.classList.remove('hidden');
          else savingsRow.classList.add('hidden');
        }
      };

      window.placeRealWhatsAppOrder = async function() {
        const keys = Object.keys(cart);
        if (keys.length === 0) {
          window.showShopToast('Empty Cart', 'Your cart is empty! Please add products to checkout.', '🛒');
          return;
        }

        const nameInput = document.getElementById('checkout-name')?.value.trim() || 'Valued Customer';
        const phoneInput = document.getElementById('checkout-phone')?.value.trim();
        const addressInput = document.getElementById('checkout-address')?.value.trim() || 'Store Pickup';

        if (!phoneInput) {
          window.showShopToast('Missing Phone Number', 'Please enter your phone number to place order & track delivery!', '📱');
          return;
        }

        let totalPrice = 0;
        let itemLines = [];
        keys.forEach(id => {
          const item = cart[id];
          totalPrice += item.price * item.qty;
          itemLines.push(`- ${item.name} (Qty: ${item.qty}) = Rs. ${item.price * item.qty}`);
        });

        const orderId = `YF-${Math.floor(1000 + Math.random() * 9000)}`;
        const newOrder = {
          order_id: orderId,
          customer_name: nameInput,
          phone: phoneInput,
          address: addressInput,
          items: itemLines,
          total: totalPrice,
          timestamp: new Date().toLocaleString(),
          status: 'Order Placed & Processing'
        };

        try {
          await fetch('/api/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(newOrder)
          });
        } catch (e) {
          console.error('Error posting order to API:', e);
        }

        try {
          let orders = JSON.parse(localStorage.getItem('yesfancy_orders') || '[]');
          orders.unshift(newOrder);
          localStorage.setItem('yesfancy_orders', JSON.stringify(orders));
        } catch (e) {}

        cart = {};
        window.saveCart();

        window.toggleCartDrawer(false);
        window.toggleTrackDrawer(true);
        const trackInput = document.getElementById('track-input');
        if (trackInput) trackInput.value = phoneInput;
        window.lookupOrderStatus();

        window.showShopToast(
          '🎉 Order Placed Successfully!',
          `Order #${orderId} (₹ ${totalPrice}) has been sent directly to ${currentShopName}. You can track your order status live right here!`,
          '🛍️'
        );
      };

      window.showShopToast = function(title, message, icon = '✨') {
        const toast = document.getElementById('shop-toast');
        const titleEl = document.getElementById('toast-title');
        const msgEl = document.getElementById('toast-message');
        const iconEl = document.getElementById('toast-icon');

        if (!toast) return;
        if (titleEl) titleEl.innerText = title;
        if (msgEl) msgEl.innerText = message;
        if (iconEl) iconEl.innerText = icon;

        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 3500);
      };

      window.toggleTrackDrawer = function(open) {
        const overlay = document.getElementById('track-overlay');
        const drawer = document.getElementById('track-drawer');
        if (open) {
          overlay?.classList.remove('opacity-0', 'pointer-events-none');
          drawer?.classList.remove('translate-x-full');
        } else {
          overlay?.classList.add('opacity-0', 'pointer-events-none');
          drawer?.classList.add('translate-x-full');
        }
      };

      window.lookupOrderStatus = async function() {
        const phone = document.getElementById('track-input')?.value.trim();
        const resultsBox = document.getElementById('track-results-box');
        if (!phone || !resultsBox) return;

        let orders = [];
        try {
          const res = await fetch('/api/orders');
          const data = await res.json();
          orders = (data.orders || []).filter(o => o.phone && o.phone.includes(phone));
        } catch (e) {}

        if (orders.length === 0) {
          resultsBox.innerHTML = `<div class="text-center py-6 text-slate-500 text-xs bg-slate-50 border border-dashed border-slate-300 rounded-lg">No active orders found for phone number ${phone}.</div>`;
        } else {
          resultsBox.innerHTML = orders.map(o => `
            <div class="border border-slate-200 rounded-lg p-3 space-y-2 bg-slate-50 mb-2">
              <div class="flex justify-between items-center text-xs font-bold">
                <span>Order #${o.order_id}</span>
                <span class="bg-emerald-100 text-emerald-800 text-[10px] px-2 py-0.5 rounded">${o.status}</span>
              </div>
              <div class="text-[11px] text-slate-600">${Array.isArray(o.items) ? o.items.join(', ') : o.items}</div>
              <div class="text-xs font-extrabold text-rose-600 pt-1 border-t border-slate-200">Total COD: ₹ ${o.total}</div>
            </div>
          `).join('');
        }
      };

      window.toggleCartDrawer = function(open) {
        const overlay = document.getElementById('cart-overlay');
        const drawer = document.getElementById('cart-drawer');
        if (!overlay || !drawer) return;
        if (open) {
          overlay.classList.remove('opacity-0', 'pointer-events-none');
          overlay.style.opacity = '1';
          overlay.style.pointerEvents = 'auto';
          drawer.style.transform = 'translateX(0)';
        } else {
          overlay.classList.add('opacity-0', 'pointer-events-none');
          overlay.style.opacity = '0';
          overlay.style.pointerEvents = 'none';
          drawer.style.transform = 'translateX(100%)';
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', window.loadCart);
      } else {
        window.loadCart();
      }
    </script>
  </div>

</body>
</html>
