{
  "name": "yesfancy",
  "version": "1.0.0",
  "description": "Yes Fancy standalone e-commerce storefront",
  "main": "index.js",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && cp -r dist/client/* dist/",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name yesfancy",
    "preview": "astro preview",
    "test": "npx tsx --test tests/**/*.test.ts",
    "test:unit": "npx tsx --test tests/unit/**/*.test.ts",
    "test:integration": "npx tsx --test tests/integration/**/*.test.ts"
  },
  "keywords": [
    "yesfancy",
    "ecommerce",
    "astro",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/node": "^11.1.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.21.0",
    "astro": "^7.1.6",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "puppeteer-core": "^25.6.0"
  }
}
