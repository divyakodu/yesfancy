---
export const prerender = false;

import '@styles/global.css';
import { getStoreConfigAsync } from '@lib/getShopConfig';
import { getTemplateComponent } from '@lib/resolveTemplate';
import StoreHeader from '@components/StoreHeader.astro';
import StoreFooter from '@components/StoreFooter.astro';
import { isStorefrontProduct } from '@core/lib/productFilter';

// Prevent serving stale product lists from browser or CDN cache
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

// Fetch direct Yes Fancy store configuration
const shop = await getStoreConfigAsync();

if (!shop) {
  throw new Error('Failed to load store configuration from database.');
}

const { theme, products: rawProducts = [], categories = [] } = shop;
const products = (rawProducts || []).filter(isStorefrontProduct);
const primaryColor = theme?.primary_color || '#581C87';
const secondaryColor = theme?.secondary_color || '#F8FAFC';
const accentColor = theme?.accent_color || '#E11D48';

const StorefrontTemplate = await getTemplateComponent(shop.template);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{shop.name} | {shop.tagline}</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <style define:vars={{ primaryColor, secondaryColor, accentColor }}>
    .badge-dark {
      background-color: #1D2228;
      color: #FFFFFF;
    }
    .add-btn {
      background-color: var(--primaryColor);
      color: #FFFFFF;
    }
    .add-btn:hover {
      opacity: 0.9;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 antialiased min-h-screen flex flex-col">

  <div class="min-h-screen flex flex-col">
    <!-- Store Header Component -->
    <StoreHeader shop={shop} primaryColor={primaryColor} />

    <!-- Storefront Template -->
    {StorefrontTemplate && (
      <StorefrontTemplate shop={{ ...shop, products }} products={products} categories={categories} primaryColor={primaryColor} />
    )}

    <!-- Store Footer Component -->
    <StoreFooter shopName={shop.name} logoUrl={shop.logo_url} primaryColor={primaryColor} />

    <!-- Slide-Over Shopping Cart Drawer -->
    <div id="cart-overlay" style="transition: opacity 0.3s ease; opacity: 0; pointer-events: none;" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50" onclick="toggleCartDrawer(false)"></div>
    <aside id="cart-drawer" style="transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); transform: translateX(100%);" class="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-white z-50 shadow-2xl flex flex-col">
      <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
        <div class="flex items-center space-x-2">
          <span class="text-xl">🛍️</span>
          <h2 class="font-extrabold text-slate-900 uppercase text-sm tracking-wider">Shopping Cart</h2>
        </div>
        <div class="flex items-center space-x-2">
          <button onclick="clearFullCart()" class="text-[11px] font-bold text-rose-600 hover:text-rose-800 hover:bg-rose-50 px-2 py-1 rounded transition-colors cursor-pointer" title="Empty Cart">Clear All</button>
          <button onclick="toggleCartDrawer(false)" class="w-8 h-8 rounded-full hover:bg-slate-200 flex items-center justify-center font-bold text-slate-600 cursor-pointer">✕</button>
        </div>
      </div>

      <div id="cart-items-container" class="flex-1 overflow-y-auto p-4 space-y-3 divide-y divide-slate-100"></div>

      <div class="p-4 border-t border-slate-200 bg-slate-50 space-y-2.5">
        <div class="space-y-1 text-xs border-b border-slate-200 pb-2">
          <div class="flex justify-between items-center text-slate-500">
            <span>Total MRP:</span>
            <span id="cart-total-mrp" class="font-bold text-slate-700">₹ 0</span>
          </div>
          <div id="cart-savings-row" class="hidden flex justify-between items-center text-emerald-700 font-bold">
            <span>Total Savings:</span>
            <span id="cart-total-savings">- ₹ 0</span>
          </div>
        </div>

        <div class="flex justify-between items-center text-sm font-bold text-slate-900">
          <span>Total Payable (COD):</span>
          <span id="cart-total-price" class="text-rose-600 font-extrabold text-base">₹ 0</span>
        </div>

        <div class="space-y-2 pt-2">
          <input type="text" id="checkout-name" placeholder="Full Name" class="w-full text-xs p-2.5 border border-slate-300 rounded focus:ring-1 focus:ring-slate-900 outline-none" />
          <input type="tel" id="checkout-phone" placeholder="Phone Number (Required for COD Tracking)" class="w-full text-xs p-2.5 border border-slate-300 rounded focus:ring-1 focus:ring-slate-900 outline-none" />
          <textarea id="checkout-address" placeholder="Delivery Address / Landmark" class="w-full text-xs p-2.5 border border-slate-300 rounded h-16 focus:ring-1 focus:ring-slate-900 outline-none resize-none"></textarea>
        </div>

        <button onclick="placeRealWhatsAppOrder()" style={`background-color: ${primaryColor}`} class="w-full py-3 text-white font-extrabold text-xs uppercase tracking-widest rounded shadow-md hover:opacity-90 transition-opacity cursor-pointer">
          Place COD Order Now ➔
        </button>
      </div>
    </aside>

    <!-- Track Order Drawer -->
    <div id="track-overlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300" onclick="toggleTrackDrawer(false)"></div>
    <aside id="track-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[380px] bg-white z-50 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col p-6 space-y-6">
      <div class="flex justify-between items-center border-b border-slate-200 pb-4">
        <h2 class="font-extrabold text-slate-900 uppercase text-sm tracking-wider">Track Your Orders</h2>
        <button onclick="toggleTrackDrawer(false)" class="w-8 h-8 rounded-full hover:bg-slate-200 flex items-center justify-center font-bold text-slate-600 cursor-pointer">✕</button>
      </div>

      <div class="space-y-3">
        <label class="text-xs font-bold text-slate-700">Enter Your Registered Phone Number:</label>
        <div class="flex gap-2">
          <input type="tel" id="track-input" placeholder="e.g. 9876543210" class="flex-1 text-xs p-2.5 border border-slate-300 rounded focus:ring-1 focus:ring-slate-900 outline-none" />
          <button onclick="lookupOrderStatus()" class="px-4 py-2.5 bg-slate-900 text-white font-bold text-xs rounded hover:bg-slate-800 cursor-pointer">Search</button>
        </div>
      </div>

      <div id="track-results-box" class="flex-1 overflow-y-auto space-y-3">
        <div class="text-center py-8 text-slate-400 text-xs">Enter phone number to view live COD order status.</div>
      </div>
    </aside>

    <!-- Celebratory Order Success Modal (Stylized Festive Confirmation) -->
    <div id="order-success-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none hidden transition-all duration-300">
      <div id="order-success-card" class="bg-white rounded-2xl max-w-md w-full p-6 sm:p-7 text-center space-y-4 shadow-2xl border border-slate-200 transform scale-95 transition-transform duration-300 relative">
        <!-- Close Button -->
        <button onclick="window.closeOrderSuccessModal()" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-900 flex items-center justify-center transition-colors cursor-pointer" title="Close">
          ✕
        </button>

        <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-3xl mx-auto shadow-inner">
          🎉
        </div>

        <div class="space-y-1">
          <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
            Order Confirmed & Received
          </span>
          <h3 class="font-serif-title font-extrabold text-xl text-slate-900 pt-1">Thank You For Your Order!</h3>
          <p class="text-xs text-slate-500">
            Order <span id="success-order-id" class="font-extrabold text-slate-900">#YF-0000</span> has been logged directly with <span class="font-bold text-slate-800">{shop?.name || 'Yes Fancy'}</span>.
          </p>
        </div>

        <!-- Structured Itemized Receipt Summary -->
        <div class="bg-slate-50 rounded-xl p-3.5 border border-slate-200/80 text-left space-y-2 text-xs">
          <div class="flex justify-between items-center border-b border-slate-200 pb-2">
            <span class="font-extrabold text-[10px] uppercase tracking-wider text-slate-400">Order Summary</span>
            <span class="text-[10px] font-bold text-emerald-700">Cash on Delivery (COD)</span>
          </div>

          <div id="success-order-items" class="space-y-1.5 max-h-36 overflow-y-auto">
            <!-- Dynamically populated item rows -->
          </div>

          <div class="pt-2 border-t border-slate-200 flex justify-between items-center font-extrabold text-slate-900">
            <span>Total Payable:</span>
            <span id="success-order-total" class="text-rose-600 text-base">₹ 0</span>
          </div>
        </div>

        <!-- Delivery Address Card -->
        <div class="bg-slate-50 rounded-xl p-3 border border-slate-200/80 text-left text-xs flex items-start space-x-2">
          <span class="text-base shrink-0">📍</span>
          <div>
            <div class="font-bold text-slate-800 text-[11px]">Delivery Destination:</div>
            <div id="success-order-address" class="text-slate-600 text-[11px] leading-tight mt-0.5">Store Pickup</div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="space-y-2 pt-2">
          <button 
            onclick="window.showTrackingFromSuccess()" 
            class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs uppercase tracking-wider rounded-xl shadow-md cursor-pointer transition-all flex items-center justify-center space-x-2"
          >
            <span>📦</span>
            <span>Track Order Status Live</span>
          </button>
          <button 
            onclick="window.closeOrderSuccessModal()" 
            class="w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs uppercase tracking-wider rounded-xl transition-colors cursor-pointer"
          >
            🛍️ Continue Shopping
          </button>
        </div>
      </div>
    </div>

    <!-- Toast Notification Modal -->
    <div id="shop-toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 text-white p-4 rounded-xl shadow-2xl flex items-center space-x-3 max-w-sm border border-slate-700">
      <span id="toast-icon" class="text-2xl">✨</span>
      <div>
        <h4 id="toast-title" class="font-bold text-xs text-white">Notification</h4>
        <p id="toast-message" class="text-[11px] text-slate-300 mt-0.5">Operation complete.</p>
      </div>
    </div>

    <script is:inline define:vars={{ currentShopName: shop?.name || 'Yes Fancy' }}>
      let cart = {};

      window.loadCart = function() {
        try {
          let saved = localStorage.getItem('yesfancy_cart');
          if (!saved) {
            // Backward compatibility fallback to migrate user cart
            saved = localStorage.getItem('oorumart_cart_yesfancy');
            if (saved) {
              localStorage.setItem('yesfancy_cart', saved);
            }
          }
          if (saved) cart = JSON.parse(saved);
        } catch (e) {
          cart = {};
        }
        window.updateCartUI();
      };

      window.saveCart = function() {
        try {
          localStorage.setItem('yesfancy_cart', JSON.stringify(cart));
        } catch (e) {}
        window.updateCartUI();
      };

      window.clearFullCart = function() {
        cart = {};
        window.saveCart();
      };

      window.addToCart = function(id, name, price, mrp, image_url, stock = 100, discount = 0) {
        const finalMrp = Number(mrp || price || 0);
        const finalDiscount = Number(discount || 0);
        const finalPrice = Math.round(finalMrp * (1 - finalDiscount / 100));

        if (cart[id]) {
          if (cart[id].qty < stock) {
            cart[id].qty += 1;
          }
        } else {
          cart[id] = { id, name, price: finalPrice, mrp: finalMrp, discount: finalDiscount, image: image_url, image_url, qty: 1, stock };
        }
        window.saveCart();
        window.toggleCartDrawer(true);
      };

      window.updateCartUI = function() {
        const container = document.getElementById('cart-items-container');
        const badge = document.getElementById('cart-count-badge');
        const totalEl = document.getElementById('cart-total-price');
        const totalMrpEl = document.getElementById('cart-total-mrp');
        const totalSavingsEl = document.getElementById('cart-total-savings');
        const savingsRow = document.getElementById('cart-savings-row');

        let totalItems = 0;
        let totalPrice = 0;
        let totalMrp = 0;
        let html = '';

        const keys = Object.keys(cart);
        keys.forEach(id => {
          const item = cart[id];
          const itemMrp = Number(item.mrp || item.price || 0);
          const itemDiscount = Number(item.discount || 0);
          const itemPrice = Math.round(itemMrp * (1 - itemDiscount / 100));
          const imgUrl = item.image_url || item.image || item.imageUrl || '/images/placeholder.webp';

          totalItems += item.qty;
          totalPrice += itemPrice * item.qty;
          totalMrp += itemMrp * item.qty;

          html += `
            <div class="p-2.5 bg-slate-50 border border-slate-200/80 rounded-xl space-y-2">
              <div class="flex items-start justify-between gap-2">
                <div class="flex items-center space-x-2.5">
                  <img src="${imgUrl}" onerror="this.onerror=null;this.src='/images/placeholder.webp';" class="w-11 h-11 object-contain p-1 bg-white border border-slate-200 rounded-lg shrink-0" alt="${item.name || 'Product'}" />
                  <div>
                    <h4 class="font-bold text-xs text-slate-900 line-clamp-1 leading-tight">${item.name}</h4>
                    <div class="flex items-center gap-1.5 pt-1">
                      <span class="text-xs text-rose-600 font-extrabold">₹ ${itemPrice}</span>
                      ${itemDiscount > 0 ? `
                        <span class="line-through text-slate-400 text-[10px]">₹ ${itemMrp}</span>
                        <span class="text-[9px] font-extrabold text-emerald-700 bg-emerald-100/70 px-1.5 py-0.2 rounded">${itemDiscount}% OFF</span>
                      ` : ''}
                    </div>
                  </div>
                </div>
                <div class="flex items-center space-x-1.5 bg-white border border-slate-200 rounded-lg p-0.5 shrink-0 shadow-2xs">
                  <button onclick="changeQty('${id}', -1)" class="w-5 h-5 bg-slate-100 hover:bg-slate-200 font-bold rounded flex items-center justify-center text-xs cursor-pointer">-</button>
                  <span class="text-xs font-bold w-5 text-center">${item.qty}</span>
                  <button onclick="changeQty('${id}', 1)" class="w-5 h-5 bg-slate-100 hover:bg-slate-200 font-bold rounded flex items-center justify-center text-xs cursor-pointer">+</button>
                </div>
              </div>
              <div class="flex justify-between items-center text-[11px] pt-1 border-t border-slate-200/60 font-semibold text-slate-500">
                <span>Subtotal (${item.qty} ${item.qty === 1 ? 'unit' : 'units'}):</span>
                <span class="font-extrabold text-slate-900">₹ ${itemPrice * item.qty}</span>
              </div>
            </div>
          `;
        });

        const totalSavings = Math.max(0, totalMrp - totalPrice);

        if (keys.length === 0) {
          html = `<div class="text-center py-12 text-slate-400 text-xs">Your cart is empty. Explore items and add them!</div>`;
        }

        if (container) container.innerHTML = html;
        if (badge) badge.innerText = totalItems;
        if (totalEl) totalEl.innerText = `₹ ${totalPrice}`;
        if (totalMrpEl) totalMrpEl.innerText = `₹ ${totalMrp}`;
        if (totalSavingsEl) totalSavingsEl.innerText = `- ₹ ${totalSavings}`;
        if (savingsRow) {
          if (totalSavings > 0) savingsRow.classList.remove('hidden');
          else savingsRow.classList.add('hidden');
        }
      };

      window.changeQty = function(id, delta) {
        if (cart[id]) {
          cart[id].qty += delta;
          if (cart[id].qty <= 0) delete cart[id];
          window.saveCart();
        }
      };

      window.showShopToast = function(title, message, icon = '✨') {
        const toast = document.getElementById('shop-toast');
        const titleEl = document.getElementById('toast-title');
        const msgEl = document.getElementById('toast-message');
        const iconEl = document.getElementById('toast-icon');

        if (!toast) return;
        if (titleEl) titleEl.innerText = title;
        if (msgEl) msgEl.innerText = message;
        if (iconEl) iconEl.innerText = icon;

        toast.classList.remove('translate-y-20', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-20', 'opacity-0');
        }, 3500);
      };

      window.toggleCartDrawer = function(open) {
        const overlay = document.getElementById('cart-overlay');
        const drawer = document.getElementById('cart-drawer');
        if (!overlay || !drawer) return;
        if (open) {
          overlay.classList.remove('opacity-0', 'pointer-events-none');
          overlay.style.opacity = '1';
          overlay.style.pointerEvents = 'auto';
          drawer.style.transform = 'translateX(0)';
        } else {
          overlay.classList.add('opacity-0', 'pointer-events-none');
          overlay.style.opacity = '0';
          overlay.style.pointerEvents = 'none';
          drawer.style.transform = 'translateX(100%)';
        }
      };

      window.toggleTrackDrawer = function(open) {
        const overlay = document.getElementById('track-overlay');
        const drawer = document.getElementById('track-drawer');
        if (open) {
          overlay?.classList.remove('opacity-0', 'pointer-events-none');
          drawer?.classList.remove('translate-x-full');
        } else {
          overlay?.classList.add('opacity-0', 'pointer-events-none');
          drawer?.classList.add('translate-x-full');
        }
      };

      window.lookupOrderStatus = async function() {
        const phone = document.getElementById('track-input')?.value.trim();
        const resultsBox = document.getElementById('track-results-box');
        if (!phone || !resultsBox) return;

        let orders = [];
        try {
          const res = await fetch('/api/orders');
          const data = await res.json();
          orders = (data.orders || []).filter(o => o.phone && o.phone.includes(phone));
        } catch (e) {}

        if (orders.length === 0) {
          resultsBox.innerHTML = `<div class="text-center py-6 text-slate-500 text-xs">No active orders found for phone number ${phone}.</div>`;
        } else {
          resultsBox.innerHTML = orders.map(o => `
            <div class="border border-slate-200 rounded-lg p-3 space-y-2 bg-slate-50">
              <div class="flex justify-between items-center text-xs font-bold">
                <span>Order #${o.order_id}</span>
                <span class="bg-emerald-100 text-emerald-800 text-[10px] px-2 py-0.5 rounded">${o.status}</span>
              </div>
              <div class="text-[11px] text-slate-600">${Array.isArray(o.items) ? o.items.join(', ') : o.items}</div>
              <div class="text-xs font-extrabold text-rose-600 pt-1 border-t border-slate-200">Total COD: ₹ ${o.total}</div>
            </div>
          `).join('');
        }
      };

      window.placeRealWhatsAppOrder = async function() {
        const keys = Object.keys(cart);
        if (keys.length === 0) {
          window.showShopToast('Empty Cart', 'Your cart is empty! Please add products to checkout.', '🛒');
          return;
        }

        const nameInput = document.getElementById('checkout-name')?.value.trim() || 'Valued Customer';
        const phoneInput = document.getElementById('checkout-phone')?.value.trim();
        const addressInput = document.getElementById('checkout-address')?.value.trim() || 'Store Pickup';

        if (!phoneInput) {
          window.showShopToast('Missing Phone Number', 'Please enter your phone number to place order & track delivery!', '📱');
          return;
        }

        let totalPrice = 0;
        let totalMrp = 0;
        let itemLines = [];
        keys.forEach(id => {
          const item = cart[id];
          const itemMrp = Number(item.mrp || item.price || 0);
          const itemDisc = Number(item.discount || 0);
          const itemPrice = Math.round(itemMrp * (1 - itemDisc / 100));

          totalPrice += itemPrice * item.qty;
          totalMrp += itemMrp * item.qty;

          const discStr = itemDisc > 0 ? ` (${itemDisc}% OFF, MRP Rs. ${itemMrp})` : '';
          itemLines.push(`- ${item.name} (Qty: ${item.qty}) = Rs. ${itemPrice * item.qty}${discStr}`);
        });

        const totalSavings = Math.max(0, totalMrp - totalPrice);
        if (totalSavings > 0) {
          itemLines.push(`*Total Customer Savings: -Rs. ${totalSavings}*`);
        }

        const orderId = `YF-${Math.floor(1000 + Math.random() * 9000)}`;
        const newOrder = {
          order_id: orderId,
          customer_name: nameInput,
          phone: phoneInput,
          address: addressInput,
          items: itemLines,
          total: totalPrice,
          timestamp: new Date().toLocaleString(),
          status: 'Order Placed & Processing'
        };

        try {
          await fetch('/api/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(newOrder)
          });
        } catch (e) {
          console.error('Error posting order to API:', e);
        }

        try {
          let orders = JSON.parse(localStorage.getItem('yesfancy_orders') || '[]');
          orders.unshift(newOrder);
          localStorage.setItem('yesfancy_orders', JSON.stringify(orders));
        } catch (e) {}

        cart = {};
        window.saveCart();

        window.toggleCartDrawer(false);

        // Store last placed order phone for tracking shortcut
        window.lastPlacedOrderPhone = phoneInput;

        // Populate and display the celebratory Order Success Modal
        const successModal = document.getElementById('order-success-modal');
        const successCard = document.getElementById('order-success-card');
        const idElem = document.getElementById('success-order-id');
        const itemsElem = document.getElementById('success-order-items');
        const totalElem = document.getElementById('success-order-total');
        const addrElem = document.getElementById('success-order-address');

        if (idElem) idElem.innerText = `#${orderId}`;
        if (totalElem) totalElem.innerText = `₹ ${totalPrice}`;
        if (addrElem) addrElem.innerText = `${addressInput} (Customer: ${nameInput}, 📞 ${phoneInput})`;

        if (itemsElem) {
          itemsElem.innerHTML = itemLines
            .filter(l => !l.startsWith('*'))
            .map(line => {
              const clean = line.replace(/^-\s*/, '');
              const match = clean.match(/^(.*?)\s*\(Qty:\s*(\d+)\)\s*(?:=\s*(?:Rs\.?\s*)?(\d+))?/i);
              if (match) {
                return `
                  <div class="flex justify-between items-center py-1 border-b border-slate-100 last:border-0">
                    <span class="font-bold text-slate-800">${match[1]} <span class="text-slate-400 font-semibold">× ${match[2]}</span></span>
                    <span class="font-extrabold text-slate-900">${match[3] ? `₹ ${match[3]}` : ''}</span>
                  </div>
                `;
              }
              return `<div class="py-0.5 text-slate-700">${clean}</div>`;
            }).join('');
        }

        if (successModal) {
          successModal.classList.remove('hidden');
          successModal.classList.remove('opacity-0', 'pointer-events-none');
        }
        if (successCard) {
          successCard.classList.remove('scale-95');
          successCard.classList.add('scale-100');
        }
      };

      window.closeOrderSuccessModal = function() {
        const modal = document.getElementById('order-success-modal');
        const card = document.getElementById('order-success-card');
        if (modal) {
          modal.classList.add('opacity-0', 'pointer-events-none');
          setTimeout(() => modal.classList.add('hidden'), 300);
        }
        if (card) {
          card.classList.remove('scale-100');
          card.classList.add('scale-95');
        }
      };

      window.showTrackingFromSuccess = function() {
        window.closeOrderSuccessModal();
        window.toggleTrackDrawer(true);
        const trackInput = document.getElementById('track-input');
        if (trackInput && window.lastPlacedOrderPhone) {
          trackInput.value = window.lastPlacedOrderPhone;
        }
        window.lookupOrderStatus();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', window.loadCart);
      } else {
        window.loadCart();
      }
    </script>
  </div>

</body>
</html>
