---
export interface Props {
  shop: {
    slug: string;
    name: string;
    logo_url?: string;
    logo_animated_url?: string;
    logo_text?: string;
    announcement_text?: string;
    categories?: Array<{ id: string; label: string }>;
  };
  primaryColor?: string;
}

const { shop, primaryColor = '#581C87' } = Astro.props;
const categories = shop.categories || [];
const logoImg = shop?.logo_animated_url || shop?.logo_url;
const logoText = shop?.logo_text || shop?.name;

const storeHomeUrl = '/';

const getCatalogUrl = (catId?: string) => {
  if (catId && catId !== 'all') {
    return `/catalog?category=${catId}`;
  }
  return '/catalog';
};
---

<!-- 1. Top Announcement Bar (High Contrast WCAG AAA Readability) -->
<div style={`background-color: ${primaryColor}`} class="text-slate-100 text-xs font-semibold py-2.5 px-4 flex items-center justify-between shadow-xs select-none border-b border-slate-800">
  <button class="hover:text-amber-400 cursor-pointer px-2 text-xs font-bold text-amber-400" title="Previous">◀</button>
  <span class="tracking-widest text-center flex-1 font-semibold uppercase text-slate-100">{shop.announcement_text || `FREE SHIPPING ON ORDERS ABOVE ₹999 | EXPRESS STORE PICKUP`}</span>
  <button class="hover:text-amber-400 cursor-pointer px-2 text-xs font-bold text-amber-400" title="Next">▶</button>
</div>

<!-- 2. Generic Reusable Header Nav (Logo Row + Embedded Mobile Search Bar) -->
<header class="sticky top-0 z-40 bg-white border-b border-slate-200 shadow-xs">
  <div class="px-4 sm:px-6 py-2.5">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 sm:gap-6 h-12 sm:h-14">
      
      <!-- Brand Logo -->
      <a href={storeHomeUrl} class="flex items-center space-x-3 shrink-0 no-underline group leading-none my-auto">
        {logoImg && (
          <img src={logoImg} alt={shop.name} class="h-9 sm:h-11 w-auto object-contain group-hover:scale-105 transition-transform shrink-0" />
        )}
        <span class="font-extrabold text-xl sm:text-2xl tracking-[0.15em] text-slate-900 font-serif-title uppercase leading-none my-auto">{logoText}</span>
      </a>

      <!-- Desktop Category Navigation Tabs (Visible ONLY on Desktop ≥ 1024px) -->
      <nav class="hidden lg:flex items-center space-x-3.5 xl:space-x-5 text-xs text-slate-800 my-auto whitespace-nowrap shrink-0">
        {categories.map((c: any, index: number) => (
          <a 
            href={getCatalogUrl(c.id)} 
            class={`cursor-pointer no-underline transition-colors py-1 whitespace-nowrap shrink-0 ${
              index === 0 || c.label.toLowerCase().includes('all product')
                ? 'font-extrabold' 
                : 'text-slate-800 hover:text-purple-900 font-bold'
            }`}
            style={index === 0 || c.label.toLowerCase().includes('all product') ? `color: ${primaryColor}` : ''}
          >
            {c.label}
          </a>
        ))}
      </nav>

      <!-- Right Actions: Desktop Search Bar + Track Order + Cart Drawer -->
      <div class="flex items-center space-x-3 sm:space-x-4 shrink-0 my-auto">
        <!-- Desktop Search Bar (Visible ONLY on Desktop ≥ 1024px) -->
        <form action="/catalog" method="GET" class="hidden lg:flex items-center relative">
          <div class="relative flex items-center">
            <svg class="w-4 h-4 text-slate-800 absolute left-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input 
              id="header-animated-search-input"
              type="text" 
              name="search" 
              placeholder="Search For Gift Sets..." 
              class="w-44 md:w-60 pl-9 pr-3 py-2 bg-white text-xs font-medium text-slate-900 placeholder-slate-500 rounded-none border border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900 transition-all shadow-2xs"
            />
          </div>
        </form>

        <!-- Explicit Track Order Button (Unmistakable on Desktop & Mobile) -->
        <button 
          onclick="toggleTrackDrawer(true)" 
          class="flex items-center space-x-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-full font-bold text-xs transition-colors cursor-pointer border border-slate-300 shadow-2xs shrink-0" 
          title="Track Your Live Orders by Mobile Number"
        >
          <span class="text-sm">📦</span>
          <span class="hidden sm:inline">Track Order</span>
          <span class="sm:hidden text-[11px]">Track</span>
        </button>

        <!-- Cart Drawer Button -->
        <button onclick="toggleCartDrawer(true)" class="relative text-slate-800 hover:text-slate-900 cursor-pointer p-1.5 hover:bg-slate-100 rounded-full transition-colors shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span id="cart-count-badge" style={`background-color: ${primaryColor}`} class="absolute -top-0.5 -right-0.5 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center">0</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 3. Mobile Search Bar Component (Inside Sticky Header, Never Truncated or Overlapped!) -->
  <div class="lg:hidden bg-slate-50 border-t border-slate-200 px-3 sm:px-4 py-2 shadow-2xs">
    <form action="/catalog" method="GET" class="flex items-center space-x-2">
      <div class="relative flex-1 flex items-center">
        <svg class="w-4 h-4 text-slate-800 absolute left-3 pointer-events-none shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input 
          id="mobile-header-search-input"
          type="text" 
          name="search" 
          placeholder="Search For Gift Sets, Home Decor..." 
          class="w-full pl-9 pr-3 py-2 bg-white text-xs font-medium text-slate-900 placeholder-slate-500 rounded border border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
        />
      </div>
      <button type="submit" style={`background-color: ${primaryColor}`} class="px-4 py-2 text-white font-extrabold text-xs uppercase tracking-wider rounded shrink-0 cursor-pointer hover:opacity-90">
        SEARCH
      </button>
    </form>
  </div>
</header>

<!-- 4. Mobile Sticky Bottom Category Tab Section (Purple Theme Color) -->
<nav class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-300 shadow-xl px-3 py-2 overflow-x-auto whitespace-nowrap flex items-center space-x-2">
  {categories.map((c: any, index: number) => (
    <a 
      href={getCatalogUrl(c.id)} 
      class={`cursor-pointer no-underline text-[11px] font-bold px-3 py-1.5 rounded-full transition-all shrink-0 border ${
        index === 0 || c.label.toLowerCase().includes('all product')
          ? 'text-white shadow-xs' 
          : 'bg-slate-100 text-slate-800 border-slate-200 hover:bg-purple-900 hover:text-white'
      }`}
      style={index === 0 || c.label.toLowerCase().includes('all product') ? `background-color: ${primaryColor}; border-color: ${primaryColor}` : ''}
    >
      {c.label}
    </a>
  ))}
</nav>
<script is:inline>
  // Typewriter Animated Placeholder Script for Header Search Bars
  (function() {
    const desktopInput = document.getElementById('header-animated-search-input');
    const mobileInput = document.getElementById('mobile-header-search-input');
    const inputs = [desktopInput, mobileInput].filter(Boolean);

    if (inputs.length > 0) {
      const phrases = [
        "Search For Gift Sets...",
        "Search For Home & Decor...",
        "Search For Bags & Travel...",
        "Search For Board Games...",
        "Search For Action Toys...",
        "Search For Lunch Boxes..."
      ];

      let phraseIndex = 0;
      let charIndex = 0;
      let isDeleting = false;
      let typeSpeed = 100;

      function typeEffect() {
        const currentPhrase = phrases[phraseIndex];
        const textToShow = isDeleting 
          ? currentPhrase.substring(0, charIndex - 1) 
          : currentPhrase.substring(0, charIndex + 1);

        inputs.forEach(input => {
          if (document.activeElement !== input || input.value.length === 0) {
            input.placeholder = textToShow;
          }
        });

        if (isDeleting) {
          charIndex--;
          typeSpeed = 40;
        } else {
          charIndex++;
          typeSpeed = 90;
        }

        if (!isDeleting && charIndex === currentPhrase.length) {
          typeSpeed = 1800;
          isDeleting = true;
        } else if (isDeleting && charIndex === 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          typeSpeed = 400;
        }

        setTimeout(typeEffect, typeSpeed);
      }

      typeEffect();
    }
  })();

  // Robust Global Order Tracking Function with Accordion & Progress Stepper
  window.lookupOrderStatus = async function() {
    const rawInput = (document.getElementById('track-input')?.value || '').trim();
    // Allow lookup either in store-header box or track-results-box
    const statusBox = document.getElementById('track-results-box') || document.getElementById('track-status-box');
    if (!rawInput || !statusBox) return;

    statusBox.innerHTML = `
      <div class="text-center py-8 space-y-2">
        <div class="text-2xl animate-spin">⏳</div>
        <div class="font-bold text-slate-800 text-xs">Locating your orders...</div>
      </div>
    `;

    const cleanInput = rawInput.replace(/\D/g, '');
    let foundOrders = [];

    // 1. Check local storage first
    try {
      const localSaved = localStorage.getItem('yesfancy_orders') || localStorage.getItem('oorumart_orders');
      if (localSaved) {
        const parsed = JSON.parse(localSaved);
        if (Array.isArray(parsed)) {
          foundOrders = parsed.filter(o => 
            (cleanInput && o.phone && String(o.phone).replace(/\D/g, '').includes(cleanInput)) || 
            (o.order_id && o.order_id.toLowerCase().includes(rawInput.toLowerCase()))
          );
        }
      }
    } catch(e) {}

    // 2. Fetch from API with safety fallback
    try {
      const res = await fetch('/api/orders');
      if (res.ok) {
        const data = await res.json();
        if (data.orders && Array.isArray(data.orders)) {
          const remoteFound = data.orders.filter(o => 
            (cleanInput && o.phone && String(o.phone).replace(/\D/g, '').includes(cleanInput)) || 
            (o.order_id && o.order_id.toLowerCase().includes(rawInput.toLowerCase())) || 
            (o.customer_name && o.customer_name.toLowerCase().includes(rawInput.toLowerCase()))
          );
          remoteFound.forEach(ro => {
            if (!foundOrders.some(fo => fo.order_id === ro.order_id)) {
              foundOrders.push(ro);
            }
          });
        }
      }
    } catch(e) {}

    if (foundOrders.length === 0) {
      statusBox.innerHTML = `
        <div class="text-center py-8 border border-dashed border-rose-300 rounded-xl space-y-2 bg-rose-50/50 p-4">
          <div class="text-3xl">📦</div>
          <div class="font-bold text-slate-800 text-xs">No Active Orders Found</div>
          <div class="text-[11px] text-slate-500">No recent orders matching "${rawInput}". Please check your 10-digit phone number.</div>
        </div>
      `;
      return;
    }

    // Sort newest first
    foundOrders.sort((a, b) => {
      const timeA = a.created_at ? new Date(a.created_at).getTime() : 0;
      const timeB = b.created_at ? new Date(b.created_at).getTime() : 0;
      return timeB - timeA;
    });

    const totalOrdersCount = foundOrders.length;
    // Cap to latest 5 orders
    const cappedOrders = foundOrders.slice(0, 5);

    const getStepperHtml = (status) => {
      const steps = [
        { label: 'Placed', key: 'Placed' },
        { label: 'Packing', key: 'Packing' },
        { label: 'Out for Delivery', key: 'Dispatched' },
        { label: 'Delivered', key: 'Delivered' }
      ];

      let currentStepIndex = 0;
      const s = (status || '').toLowerCase();
      if (s.includes('delivered')) currentStepIndex = 3;
      else if (s.includes('dispatched') || s.includes('out for delivery')) currentStepIndex = 2;
      else if (s.includes('confirm') || s.includes('packing')) currentStepIndex = 1;
      else currentStepIndex = 0;

      return `
        <div class="pt-3 pb-1">
          <div class="flex items-center justify-between relative">
            <div class="absolute left-2.5 right-2.5 top-2.5 h-0.5 bg-slate-200 -z-0"></div>
            <div class="absolute left-2.5 top-2.5 h-0.5 bg-emerald-600 -z-0 transition-all" style="width: ${(currentStepIndex / 3) * 100}%"></div>
            ${steps.map((st, i) => {
              const isDone = i <= currentStepIndex;
              const isCurrent = i === currentStepIndex;
              return `
                <div class="flex flex-col items-center relative z-10">
                  <div class="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${
                    isDone ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-500'
                  } ${isCurrent ? 'ring-3 ring-emerald-200 ring-offset-1' : ''}">
                    ${isDone ? '✓' : i + 1}
                  </div>
                  <span class="text-[9px] mt-1 font-bold ${isCurrent ? 'text-emerald-700' : 'text-slate-500'} text-center">${st.label}</span>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    };

    const statusBadgeColors = {
      'Order Placed & Processing': 'bg-amber-100 text-amber-800 border-amber-200',
      'Order Confirmed & Packing': 'bg-blue-100 text-blue-800 border-blue-200',
      'Dispatched / Out for Delivery': 'bg-purple-100 text-purple-800 border-purple-200',
      'Delivered': 'bg-emerald-100 text-emerald-800 border-emerald-200',
      'Cancelled': 'bg-rose-100 text-rose-800 border-rose-200'
    };

    let html = `
      <div class="text-[11px] font-bold text-slate-500 pb-2 flex justify-between items-center">
        <span>Showing ${cappedOrders.length} of ${totalOrdersCount} orders</span>
        <span class="text-emerald-700">● Live Status Active</span>
      </div>
      <div class="space-y-3">
    `;

    cappedOrders.forEach((order, idx) => {
      const isFirst = idx === 0;
      const orderId = order.order_id || 'ORDER';
      const badgeStyle = statusBadgeColors[order.status] || 'bg-slate-100 text-slate-800 border-slate-200';
      const itemsArr = Array.isArray(order.items) ? order.items : [order.items];

      const itemRows = itemsArr.map(itemStr => {
        const str = String(itemStr || '').replace(/^-\s*/, '');
        const match = str.match(/^(.*?)\s*\(Qty:\s*(\d+)\)\s*(?:=\s*(?:Rs\.?\s*)?(\d+))?$/i);
        if (match) {
          return `
            <div class="flex justify-between items-center py-1 text-xs border-b border-slate-100">
              <span class="font-medium text-slate-800">${match[1]} <span class="text-slate-400 font-bold">× ${match[2]}</span></span>
              <span class="font-bold text-slate-900">${match[3] ? `₹ ${match[3]}` : ''}</span>
            </div>
          `;
        }
        return `
          <div class="py-1 text-xs font-medium text-slate-700 border-b border-slate-100">${str}</div>
        `;
      }).join('');

      html += `
        <div class="border border-slate-200 rounded-xl overflow-hidden bg-white shadow-2xs transition-all">
          <!-- Accordion Header (Click to Expand / Collapse) -->
          <button 
            type="button" 
            onclick="window.toggleOrderAccordion('order-acc-${orderId}')" 
            class="w-full p-3.5 flex items-center justify-between text-left bg-slate-50 hover:bg-slate-100/70 transition-colors cursor-pointer"
          >
            <div class="space-y-0.5">
              <div class="flex items-center space-x-2">
                <span class="font-black text-slate-900 text-xs">#${orderId}</span>
                <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded border ${badgeStyle}">${order.status || 'Processing'}</span>
              </div>
              <div class="text-[10px] text-slate-400">
                ${order.created_at ? new Date(order.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Recent'}
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <span class="text-xs font-extrabold text-slate-900">₹ ${order.total || 0}</span>
              <span id="chevron-order-acc-${orderId}" class="text-slate-400 font-bold text-xs transform transition-transform ${isFirst ? 'rotate-180' : ''}">▼</span>
            </div>
          </button>

          <!-- Accordion Collapsible Body -->
          <div id="order-acc-${orderId}" class="${isFirst ? 'block' : 'hidden'} p-3.5 space-y-3 bg-white border-t border-slate-200">
            <!-- 4-Step Stepper -->
            ${getStepperHtml(order.status)}

            <!-- Itemized Table / List -->
            <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100 space-y-1">
              <div class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400">Items Ordered</div>
              ${itemRows}
              <div class="flex justify-between items-center pt-2 text-xs font-bold text-slate-900">
                <span>Total COD Payable:</span>
                <span class="text-rose-600 font-extrabold">₹ ${order.total || 0}</span>
              </div>
            </div>

            <!-- Delivery Address -->
            <div class="text-[11px] text-slate-600 flex items-start space-x-1.5">
              <span class="shrink-0">📍</span>
              <span class="font-medium">${order.address || 'Store Pickup'}</span>
            </div>

            <!-- WhatsApp Store Support Link -->
            <div class="pt-1">
              <button 
                type="button" 
                onclick="window.openWhatsAppDirect ? window.openWhatsAppDirect('919014838640', 'Hi Yes Fancy, I need an update on my Order #${orderId}.') : window.open('https://wa.me/919014838640?text=' + encodeURIComponent('Hi Yes Fancy, I need an update on my Order #${orderId}.'), '_blank')" 
                class="w-full py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold text-xs rounded border border-emerald-200 text-center flex items-center justify-center space-x-1.5 cursor-pointer transition-colors"
              >
                <span>💬 WhatsApp Store Support</span>
              </button>
            </div>
          </div>
        </div>
      `;
    });

    html += `</div>`;
    statusBox.innerHTML = html;
  };

  window.toggleOrderAccordion = function(accId) {
    const body = document.getElementById(accId);
    const chevron = document.getElementById('chevron-' + accId);
    if (!body) return;
    const isHidden = body.classList.contains('hidden');
    if (isHidden) {
      body.classList.remove('hidden');
      if (chevron) chevron.classList.add('rotate-180');
    } else {
      body.classList.add('hidden');
      if (chevron) chevron.classList.remove('rotate-180');
    }
  };
</script>
